{
  "hosting": 
  [
    {
      "target": "main",
      "public": "public",
      "ignore": [
        "firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "admin",
      "public": "/frontend/gmc/build",
      "ignore": [
        "firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
]
}
